# ============================================================
# AI API 配置文件  —  复制此文件为 .env 并填入真实值
# ============================================================

# ---------- OpenAI 官方 ----------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o

# ---------- DeepSeek ----------
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# DEFAULT_MODEL=deepseek-chat

# ---------- 通义千问 (阿里云) ----------
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEFAULT_MODEL=qwen-max

# ---------- 本地 Ollama ----------
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# DEFAULT_MODEL=llama3

# ---------- Hugging Face ----------
# 免费申请: https://huggingface.co/settings/tokens  (选 Read 权限即可)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# 默认调用的 HF 模型（中文推荐 Qwen，英文推荐 Mistral）
HF_DEFAULT_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------- 其他 ----------
AVAILABLE_MODELS=gpt-4o,gpt-4o-mini,gpt-3.5-turbo
CORS_ALLOW_ORIGINS=https://hekeyi0386-dot.github.io
MODEL_TIMEOUT=20

# 服务监听端口
PORT=8000
